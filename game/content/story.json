          "presentation": "center"
        },
        {
          "id": "G5-05-04",
          "speaker": "屏幕文字",
          "text": "我的第二段人生，即将开始。",
          "delivery": "screen_text",
          "presentation": "center"
        }
      ]
    }
  ]
